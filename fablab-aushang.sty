\RequirePackage{graphicx}
\RequirePackage[table]{xcolor}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{amssymb}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,calc}
\RequirePackage{eso-pic}
\RequirePackage{enumitem}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage{refcount}

% Versionsnummer wie in fablab-document (version.tex erzeugt make)
\InputIfFileExists{version}{}{\newcommand{\Version}{Entwurf \today}}

\definecolor{fablab}{RGB}{20,51,105}
\definecolor{kopf}{gray}{0.88}
\definecolor{englisch}{gray}{0.38}
% Farben des Fabcube, blass wie im Hintergrund
\definecolor{fcRot}{HTML}{EBB9A9}
\definecolor{fcGruen}{HTML}{C0D7C9}
\definecolor{fcBlau}{HTML}{A9ABC0}
\definecolor{warnung}{HTML}{C8202F}
% Ampelfarben der Maschinenschilder (fau-fablab/hinweisschilder)
\definecolor{ampelGruen}{HTML}{66FF66}
\definecolor{ampelGelb}{HTML}{FFF08A}
\definecolor{ampelRot}{HTML}{FF6666}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[L]{\scriptsize Quelle: \texttt{github.com/fau-fablab/docs}}
\fancyfoot[R]{\scriptsize Version \Version
  \ifnum\getpagerefnumber{LastPage}>1 \quad Seite \thepage\ von \pageref*{LastPage}\fi}
\setlength{\parindent}{0pt}

\newcommand{\Logo}[1]{%
  \IfFileExists{fablab-document/logo/Logo/Logo-FAU-bunt.pdf}%
    {\includegraphics[height=#1]{fablab-document/logo/Logo/Logo-FAU-bunt.pdf}}{\textbf{FAU FabLab}}}

% ---------------------------------------------------------------------
%  Formulare und Tabellen
% ---------------------------------------------------------------------
% Kopf der Seite: Titel, Zeile darunter (#2), Logo
\newsavebox{\LogoBox}
\newcommand{\Kopf}[2]{%
\sbox{\LogoBox}{\Logo{11mm}}%
\begin{minipage}[b]{\dimexpr\linewidth-\wd\LogoBox-4mm\relax}
  {\LARGE\bfseries #1}\\[2mm]
  \normalsize #2
\end{minipage}\hfill
\usebox{\LogoBox}\\[1mm]
{\color{fablab}\rule{\linewidth}{0.8pt}}\\[1.5mm]}

% ---------------------------------------------------------------------
%  Schilder
% ---------------------------------------------------------------------
% Schriftgrößen wachsen mit dem Papier: A4 = 1, A3 = 1.41, A5 = 0.71
\newlength{\SchildText}
\newlength{\SchildTitel}
\newlength{\SchildLogo}
\newcommand{\SchildFaktor}{1}
\AtBeginDocument{%
  \pgfmathsetmacro{\SchildFaktor}{min(\paperwidth,\paperheight)/597.50787}%  210mm
  \setlength{\SchildText}{\SchildFaktor\dimexpr 25pt\relax}%
  \setlength{\SchildTitel}{\SchildFaktor\dimexpr 60pt\relax}%
  % im Hochformat ein kleineres Logo, damit der Titel Platz hat
  \ifdim\paperwidth<\paperheight
    \setlength{\SchildLogo}{\SchildFaktor\dimexpr 10mm\relax}%
  \else
    \setlength{\SchildLogo}{\SchildFaktor\dimexpr 15mm\relax}%
  \fi}

% große Schrift für den Rest des Dokuments, Flattersatz;
% #1 = Faktor für die Textgröße (Standard 1), z.B. 0.8 bei viel Text
\newcommand{\SchildAbsatz}{%
  \setlength{\parskip}{0.6\SchildText}\raggedright}
\newcommand{\Schild}[1][1]{%
  \setlength{\SchildText}{#1\SchildText}%
  \fontsize{\SchildText}{1.25\SchildText}\selectfont
  \setlist{nosep, leftmargin=1.1em, label=\textbullet, itemsep=0.35\SchildText}%
  \SchildAbsatz}
\newcommand{\GrossSchrift}{\fontsize{1.6\SchildText}{1.9\SchildText}\selectfont}
\newcommand{\Gross}[1]{{\GrossSchrift #1}}
\newcommand{\Klein}[1]{{\fontsize{0.6\SchildText}{0.75\SchildText}\selectfont #1\par}}

% Textspalte auf einem Schild, z.B. links neben dem Fabcube
\newenvironment{Spalte}[1][0.7\linewidth]
  {\begin{minipage}[t]{#1}\SchildAbsatz}
  {\end{minipage}}

% Englischer Text: grau und kursiv
\newcommand{\en}[1]{{\color{englisch}\itshape #1}}

% Kopf eines Schildes: großer Titel links, Logo rechts, blaue Linie
% #1 = Faktor für die Titelgröße (Standard 1), z.B. 0.6 für lange Titel
\newcommand{\SchildKopf}[2][1]{%
  \par\noindent
  \sbox{\LogoBox}{\Logo{\SchildLogo}}%
  \begin{minipage}[b]{\dimexpr\linewidth-\wd\LogoBox-\SchildText\relax}
    \fontsize{#1\SchildTitel}{1.15\dimexpr#1\SchildTitel\relax}\selectfont\raggedright #2
  \end{minipage}\hfill
  \usebox{\LogoBox}\par\vspace{0.2\SchildText}
  {\color{fablab}\rule{\linewidth}{\SchildFaktor\dimexpr1.5pt\relax}}\par
  \vspace{0.5\SchildText}}

% farbiger Balken über die ganze Breite (Standard: blasses Grün)
\newcommand{\Banner}[2][fcGruen]{%
  \par\noindent
  \tikz\node[fill=#1, rounded corners=0.3\SchildText, inner xsep=0.6\SchildText,
    inner ysep=0.35\SchildText, text width=\linewidth-1.2\SchildText, align=left]
    {\strut #2};\par}

% roter Warnbalken, weiße Schrift (auch der englische Text)
\newcommand{\WarnBanner}[1]{%
  \Banner[warnung]{\color{white}\renewcommand{\en}[1]{{\itshape ##1}}#1}}

% Fabcube blass im Hintergrund unten rechts, auf allen folgenden Seiten
\newlength{\FabcubeGroesse}
\newcommand{\Fabcube}{%
  \AddToShipoutPictureBG{%
    \setlength{\FabcubeGroesse}{0.62\dimexpr\ifdim\paperwidth<\paperheight\paperwidth\else\paperheight\fi\relax}%
    \AtPageLowerLeft{%
      \put(\LenToUnit{\paperwidth-0.78\FabcubeGroesse},\LenToUnit{-0.22\FabcubeGroesse}){%
        \tikz\node[opacity=0.32, inner sep=0pt]
          {\includegraphics[width=\FabcubeGroesse]{img/fab_cube.pdf}};}}}}
