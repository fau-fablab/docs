% Fußzeile mit Quelle und Version.
%
% Papierformat und Ausrichtung über die Klassenoptionen, z.B.
%   \documentclass[a4paper,landscape,10pt]{scrartcl}
%   \usepackage{fablab-aushang}
%
% Formulare und Tabellen:  \Kopf{Titel}{Zeile darunter}
% Schilder:                \Schild  (große Schrift, passend zum Papierformat)
%                          \SchildKopf{Titel}  \en{englischer Text}
%                          \Banner[Farbe]{Text}  \Fabcube (Hintergrund)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{fablab-aushang}[2026/10/10 Aushänge FAU FabLab]

